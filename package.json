{
  "name": "cookiedumper",
  "version": "2.4.0",
  "description": "Secure on-demand cookie dumping over a token-gated localhost endpoint. Chrome (MV3) extension + native host (HTTP server) + CLI client.",
  "bin": {
    "cookiedumper": "cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "host:install": "node cli.js host install",
    "host:uninstall": "node cli.js host uninstall"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Aaron Bockelie",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronsb/cookiedumper"
  },
  "files": [
    "cli.js",
    "host.js",
    "format.js"
  ]
}
