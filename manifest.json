{
  "manifest_version": 3,
  "name": "Cookie Dumper",
  "version": "2.4.4",
  "key": "",
  "description": "Secure, on-demand cookie dumping: any site, as dotenv/JSON/shell, served over a token-gated localhost endpoint by a local native host. Nothing written to disk.",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cookie Dumper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
